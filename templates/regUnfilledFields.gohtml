<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta http-equiv="refresh" content="3; url=/register">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GoPulse — Missing Fields</title>
    <link rel="stylesheet" href="/assets/styles.css">
    <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg">
    <script src="https://kit.fontawesome.com/4e7e922e98.js" crossorigin="anonymous"></script>
</head>
<body>
 <div class="navbar">
  <a href="/">GoPulse</a>
  <div class="nav-actions">
    <a href="/login" class="nav-link-btn"><i class="fa-solid fa-right-to-bracket"></i> Login</a>
    <a href="/register" class="nav-link-btn nav-link-btn--accent"><i class="fa-solid fa-user-plus"></i> Register</a>
  </div>
 </div>

 <div class="alert-page">
   <div class="alert-card alert-card--danger">
     <div class="alert-card__icon">
       <i class="fa-solid fa-circle-exclamation"></i>
     </div>
     <h1 class="alert-card__title">Incomplete Data</h1>
     <p class="alert-card__message">All fields are required, including avatar selection. Please fill in every field to proceed.</p>
     <div class="alert-card__countdown">
       <div class="alert-card__bar"></div>
     </div>
     <p class="alert-card__redirect">Redirecting to registration in <span class="alert-card__seconds">3</span>s...</p>
     <a href="/register" class="btn-hero btn-hero--outline alert-card__action"><i class="fa-solid fa-rotate-left"></i> Try Again Now</a>
   </div>
 </div>

<script>
(function() {
  var s = 3, el = document.querySelector('.alert-card__seconds');
  var t = setInterval(function() { s--; if (el) el.textContent = s; if (s <= 0) clearInterval(t); }, 1000);
})();
</script>
</body>
</html>
