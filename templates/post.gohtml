
{{template "header"}}

<div class="page-wrap">
{{range .Posts}}

  <article class="forum-postPage">
    <!-- Author bar -->
    <div class="post-detail__author-bar">
      <img src="{{.Image}}" alt="{{.Author}}">
      <div class="post-detail__author-info">
        <span class="post-detail__author-name">{{.Author}}</span>
        <span class="post-detail__time"><i class="fa-regular fa-clock"></i> {{.PostTimeStr}}</span>
      </div>
    </div>

    <!-- Title -->
    <p class="titleofPost">{{.Title}}</p>

    <!-- Content -->
    <p class="contentofPost">{{.Content}}</p>

    <!-- Footer bar -->
    <div class="post-detail__footer">
      <div class="post-detail__meta-row">
        <form action="/category" method="GET">
          <input type="submit" name="categoryAllPosts" class="categoryclass" value="{{.Category}}">
        </form>
        <span class="post-detail__views"><i class="fa-solid fa-eye"></i> {{.View}} views</span>
      </div>
      <div class="post-detail__actions">
        <form action="/login" method="get" class="post-detail__vote-form">
          <button type="submit" name="po-like" class="Like" value="{{.PostID}}-{{.Likes}}"><i class="fa-solid fa-heart"></i></button>
          <span>{{.Likes}}</span>
        </form>
        <form action="/login" method="get" class="post-detail__vote-form">
          <button type="submit" name="po-dislike" class="Dlike" value="{{.PostID}}-{{.Dislikes}}"><i class="fa-solid fa-heart-crack"></i></button>
          <span>{{.Dislikes}}</span>
        </form>
      </div>
    </div>
  </article>

  <!-- Comments heading -->
  <div class="comments-section">
    <h3 class="comments-section__heading"><i class="fa-solid fa-comments"></i> Responses</h3>

    {{range .Comments}}
    <div class="forum-comment">
      <div class="comment__header">
        <span class="comment__author"><i class="fa-regular fa-user"></i> {{.Author}}</span>
        <span class="comment__time"><i class="fa-regular fa-clock"></i> {{.CommentTimeStr}}</span>
      </div>
      <p>{{.Content}}</p>
      <div class="comment__actions">
        <form action="/login" method="get" class="post-detail__vote-form">
          <button type="submit" name="com-like" class="Like" value="{{.PostID}}-{{.CommentID}}-{{.Likes}}"><i class="fa-solid fa-heart"></i></button>
          <span>{{.Likes}}</span>
        </form>
        <form action="/login" method="get" class="post-detail__vote-form">
          <button type="submit" name="com-dislike" class="Dlike" value="{{.PostID}}-{{.CommentID}}-{{.Dislikes}}"><i class="fa-solid fa-heart-crack"></i></button>
          <span>{{.Dislikes}}</span>
        </form>
      </div>
    </div>
    {{end}}
  </div>

  <!-- Comment input -->
  <div class="commentInput">
    <h3 class="comment-input__heading"><i class="fa-solid fa-pencil"></i> Add a Response</h3>
    <form action="/login" method="get" class="comment-input__form">
      <label for="comment">Your comment</label>
      <textarea type="text" id="comment" name="comment" rows="4" cols="30" placeholder="Share your thoughts..."></textarea>
      <button type="submit" name="post-id" value="{{.PostID}}"><i class="fa-solid fa-paper-plane"></i> Comment</button>
    </form>
  </div>

{{end}}
</div>

{{template "footer"}}
