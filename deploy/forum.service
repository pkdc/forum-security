[Unit]
Description=Forum web application
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=forum
Group=forum
WorkingDirectory=/opt/forum

# Let's Encrypt / autocert mode
Environment=USE_AUTOCERT=true
Environment=DOMAIN=yourdomain.com

ExecStart=/opt/forum/forum
Restart=on-failure
RestartSec=5s

# Allow binding to ports 80 and 443 without root
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Harden the service
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/forum

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=forum

[Install]
WantedBy=multi-user.target
